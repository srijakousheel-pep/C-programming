#include<stdio.h>
int main()
{
int n,sum=0,digit,original;
printf("Enter the value:");
scanf("%d",&n);
original=n;
while(n!=0)
{
digit=n%10;
sum=sum+(digit*digit*digit);
n=n/10;
}
if(sum==original)
{
printf("%d is Armstrong number",original);
}
else
{
printf("%d is not armstrong number",original);
}
return 0;
}
